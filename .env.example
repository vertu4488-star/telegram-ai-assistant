# Telegram Bot Token obtained from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Google Gemini API Key obtained from Google AI Studio (https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model Name (default: gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# IMPORTANT: SQLite is NOT durable on Render Free web services.
# Use SQLite only for local development; production must use an external PostgreSQL
# database AFTER safely backing up/importing the existing local bot.db file.
# Neon project: new-iphone-service-bot (credentials only in Render environment).
DATABASE_URL=sqlite+aiosqlite:///./bot.db
# Production example (do not commit a real password):
# DATABASE_URL=postgresql+asyncpg://user:password@host/new_iphone_bot?ssl=require

# Telegram User ID of the bot administrator (optional, e.g., 123456789)
ADMIN_USER_ID=

# Maximum number of recent conversation messages to keep as context (default: 20)
MAX_HISTORY_MESSAGES=20

# Maximum number of requests allowed per user per minute (default: 10)
RATE_LIMIT_MESSAGES_PER_MINUTE=10

# Request timeout in seconds for Gemini API calls (default: 30)
REQUEST_TIMEOUT_SECONDS=30
